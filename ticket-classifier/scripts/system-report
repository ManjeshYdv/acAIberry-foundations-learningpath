#!/bin/bash

echo "=== System Report ==="
echo "Date: $(date)"
echo "User: $USER"
echo "--------------------"

# Display Disk Usage
echo "Disk Usage:"
df -h | grep '^/dev/'

# Display Memory Usage
echo "Memory Usage:"
free -h

# INTENTIONAL BUG/IMPROVEMENT NEEDED BELOW:
# This line tries to show the script version, but the variable isn't defined!
echo "Script Version: $VERSION" 
